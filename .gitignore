# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Секреты: токен ВК для vkapi.py. На GitHub он живёт в Actions secrets,
# в репозиторий не попадает никогда.
.env

# Ключ сервисного аккаунта Firebase — полный админский доступ к проекту.
*firebase-adminsdk*.json
service-account*.json

# Virtual envs
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Runtime logs
*.log

# HSV dumps from the "Тест детекции" button (labelled copies live in tests/fixtures/)
/hsv_*.png

# Raw frame dumps from the "Сохранить последние кадры" button
/debug_frames/

# Per-day activity totals — see app/core/daily_log.py
/logs/

# Записка помощника самому себе через перезапуск игры — живёт секунды
# (см. app/core/restart_state.py)
/restart.json
/restart_logs.json
