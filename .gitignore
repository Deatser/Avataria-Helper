# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Секреты: токен ВК для vkapi.py. На GitHub он живёт в Actions secrets,
# в репозиторий не попадает никогда.
.env

# Ключ сервисного аккаунта Firebase — полный админский доступ к проекту.
*firebase-adminsdk*.json
service-account*.json

# Virtual envs
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Runtime logs
*.log

# HSV dumps from the "Тест детекции" button (labelled copies live in tests/fixtures/)
/hsv_*.png

# Raw frame dumps from the "Сохранить последние кадры" button
/debug_frames/

# Кадры, на которых хоккейная ловля увидела красное — по снимку на въезд,
# несколько мегабайт за минуту наблюдения (см. modules/hockey/red_watch.py)
/templates/red_catch/

# Per-day activity totals — see app/core/daily_log.py
/logs/

# Записка помощника самому себе через перезапуск игры — живёт секунды
# (см. app/core/restart_state.py)
/restart.json
/restart_logs.json

# Видеофонов в репозитории больше нет: фон окна - это картинка из templates/
# или нарисованная панелью сцена (см. app/ui/widgets/vw_panel.py). Видео
# весило сотни мегабайт и не пролезало в GitHub.
*.mp4

# Дампы калибровки и прогонов тестов - десятки мегабайт скриншотов
/testlogs/
# Подённые итоги Тропикании, как и /logs/ у основного помощника
/logs_tropikania/

# Черновики с живыми токенами в открытом виде - в публичный репозиторий им нельзя
/twitch_monitor.py
/vk_test_post.py

# Сборка установщика: папка PyInstaller, готовое приложение и сам setup.exe
/build/
/dist/
/Output/
